<% layout("layouts/boilerplate") %>
<div class="row mt-3">
  <div class="col-8 offset-2">
    <h3>Search Results for "<%= query %>"</h3>
    <p class="text-muted"><%= count %> listing(s) found</p>
    <hr />

    <% if (searchResults.length === 0) { %>
      <div class="alert alert-info">
        No listings found matching your search. Try different keywords like "beach", "mountain", "temple", or search by location.
      </div>
      <a href="/listings" class="btn btn-primary">Browse All Listings</a>
    <% } else { %>
      <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <% searchResults.forEach(function(listing) { %>
          <a href="/listings/<%=listing._id %>" class="listing-link">
            <div class="card listing-card">
              <img class="card-img-top" src="<%= listing.image.url %>" alt="listing_image" style="height: 20rem;">
              <div class="card-img-overlay"></div>
              <div class="card-body">
                <p class="card-text">
                  <b><%= listing.title %></b><br />
                  &#8377; <%= listing.price.toLocaleString("en-IN")%> / Night<br />
                  <small class="text-muted"><%= listing.location %>, <%= listing.country %></small>
                </p>
                <% if (listing.tags && listing.tags.length > 0) { %>
                  <div class="mt-2">
                    <% listing.tags.forEach(function(tag) { %>
                      <span class="badge bg-secondary"><%= tag %></span>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>
