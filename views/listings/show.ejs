<% layout("layouts/boilerplate") %>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="row mt-3">
  <div class="col-8 offset-3">
    <h3><%= listing.title %></h3>
  </div>

  <!-- Listing Card -->
  <div class="card col-6 offset-3 show-card listing-card">
    <img 
      class="card-img-top show-img" 
      src="<%= listing.image.url %>" 
      alt="listing_image"
    />
    <div class="card-body">
      <p class="card-text">
        <%= listing.description %> <br>
        &#8377; <%= listing.price.toLocaleString("en-IN") %> <br>
        <%= listing.location %> <br>
        <%= listing.country %>
      </p>
    </div>
  </div>

  <br />

  <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
    <!-- Edit/Delete Buttons -->
    <div class="btns">
      <a 
        href="/listings/<%= listing._id %>/edit" 
        class="btn btn-dark col-1 offset-3 edit-btn"
      >
        Edit
      </a>
      <form 
        method="POST" 
        action="/listings/<%= listing._id %>?_method=DELETE" 
        style="display: inline-block;"
      >
        <button class="btn btn-dark offset-5">Delete</button>
      </form>
    </div>
  <% } %>

  <!-- Payment Button -->
  <% if (currUser && !currUser._id.equals(listing.owner._id)) { %>
    <div class="col-6 offset-3 mb-3">
      <button 
        id="pay-button" 
        class="btn btn-primary btn-lg w-100"
        data-listing-id="<%= listing._id %>"
        data-listing-title="<%= listing.title %>"
        data-listing-price="<%= listing.price %>"
      >
        Book Now - &#8377; <%= listing.price.toLocaleString("en-IN") %>
      </button>
    </div>
  <% } %>

  <!-- Review Form -->
  <div class="col-8 offset-3 mb-3">
    <hr />
    <h4>Leave a Review</h4>
    <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
      
      <fieldset class="starability-heartbeat">
        <legend>Rating:</legend>
        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
        <label for="first-rate1" title="Terrible">1 star</label>
        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
        <label for="first-rate2" title="Not good">2 stars</label>
        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
        <label for="first-rate3" title="Average">3 stars</label>
        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
        <label for="first-rate4" title="Very good">4 stars</label>
        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
        <label for="first-rate5" title="Amazing">5 stars</label>
      </fieldset>

      <div class="mb-3 mt-3">
        <label for="comment" class="form-label">Comments</label>
        <textarea
          cols="30"
          rows="5"
          id="comment"
          name="review[comment]"
          class="form-control"
          required
        ></textarea>
        <div class="invalid-feedback">Please add some comments for review</div>
      </div>

      <button class="btn btn-outline-dark">Submit</button>
    </form>

    <!-- Reviews Section -->
    <hr />
    <% if(listing.reviews.length > 0) {%>
    <div class="row">
      <p><b>All Reviews</b></p>
      <% for (let review of listing.reviews) { %>
        <div class="col-md-5 mb-4 ms-3">
          <div class="card shadow-sm">
            <div class="card-body">
              <h5 class="card-title">@<%= review.author.username %></h5>
              <p class="card-text"><%= review.comment %></p>
              <p class="starability-result" data-rating="<%= review.rating %>">
                Rated: <%= review.rating %> star<%= review.rating > 1 ? "s" : "" %>
              </p>
              <% if (currUser && currUser._id.equals(review.author._id)) { %>
                <form class="mt-2" 
                  method="POST" 
                  action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                  <button class="btn btn-sm btn-dark">Delete</button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      <% } %>
    </div>
    <% } %>
    <div class="col-6 mb-3">
        <h3>Where you'll be</h3>
        <div id="map"></div>
    </div>
  </div>
</div>

<script defer src="/js/map.js"></script>
<script>
  document.getElementById('pay-button').addEventListener('click', async function(e) {
    const listingId = this.getAttribute('data-listing-id');
    const listingTitle = this.getAttribute('data-listing-title');
    const listingPrice = this.getAttribute('data-listing-price');

    try {
      const response = await fetch(`/listings/${listingId}/create-order`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        }
      });

      const orderData = await response.json();

      if (!orderData.order_id) {
        alert('Failed to create payment order');
        return;
      }

      const options = {
        key: orderData.key_id,
        amount: orderData.amount,
        currency: orderData.currency,
        name: 'Tripsy',
        description: `Booking for ${listingTitle}`,
        order_id: orderData.order_id,
        handler: async function(response) {
          const verifyResponse = await fetch('/verify-payment', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              razorpay_order_id: response.razorpay_order_id,
              razorpay_payment_id: response.razorpay_payment_id,
              razorpay_signature: response.razorpay_signature,
              listing_id: listingId
            })
          });

          const verifyData = await verifyResponse.json();

          if (verifyData.success) {
            alert('Payment successful! Your booking is confirmed.');
            window.location.href = verifyData.redirect_url;
          } else {
            alert('Payment verification failed. Please contact support.');
          }
        },
        prefill: {
          name: '<%= currUser ? currUser.username : "" %>',
          email: '<%= currUser ? currUser.email : "" %>'
        },
        theme: {
          color: '#3399cc'
        },
        modal: {
          ondismiss: function() {
            console.log('Checkout form closed');
          }
        }
      };

      const rzp = new Razorpay(options);
      rzp.open();

      rzp.on('payment.failed', function(response) {
        alert('Payment failed. Please try again.');
        console.error('Payment failed:', response.error);
      });

    } catch (error) {
      console.error('Error:', error);
      alert('Something went wrong. Please try again.');
    }
  });
</script>